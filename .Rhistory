filter(Label == "Smart Phone") %>%
filter(!is.na(countries_of_authors)) %>%
group_by(countries_of_authors) %>%
summarise(num_papers = n_distinct(PMID), .groups = "drop")
# 2. Prepare a world map frame
world_map <- map_data("world") %>%
filter(region != "Antarctica")
# 3. Join the publication counts to the map data:
choropleth_map <- world_map %>%
left_join(country_pubs, by = c("region" = "countries_of_authors"))
# 4. Plot:
smart_phone_publications_choropleth <- ggplot(choropleth_map, aes(x = long, y = lat, group = group, fill = num_papers)) +
geom_polygon(colour = "black", size = 0.2) +
coord_fixed(1.3) +
scale_fill_gradient(
name    = "No. publications",
low     = "#FAFFFF",
high    = "#289998",
na.value= "grey"
) +
scale_x_continuous(expand = c(.001, .001)) +
# scale_y_continuous(expand = c(.001, .001)) +
plot_theme +
theme(
axis.text = element_blank(),
axis.ticks = element_blank(),
axis.title = element_blank(),
axis.line.x = element_blank(),
axis.line.y = element_blank()
# plot.margin = margin(-20,0,-1,-30)
) +
labs(
title    = "Smart Phone",
# subtitle = "Shaded by total number of behavioural addictions papers",
caption  = ""
)
smart_phone_publications_choropleth
# 5. Save:
ggsave("Figures/smart_phone_publications_choropleth.pdf",
plot = smart_phone_publications_choropleth,
width = 10, height = 5.5, dpi = 600)
(gambling_publications_choropleth + gaming_publications_choropleth)/
(internet_publications_choropleth + smart_phone_publications_choropleth)
